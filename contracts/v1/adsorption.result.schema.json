{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:catalysis:contract:adsorption:result:1",
  "title": "adsorption.result v1",
  "description": "One outcome per adsorbed structure. Adsorption energy = (E_adsorbed − E_clean − sum(coefficient × E_gas)) / adsorbed_units. Negative values indicate favorable adsorption relative to the declared references. Candidate energies must agree with the independent calculation within 0.001 eV per adsorbate.",
  "type": "object",
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "structure_id": {
                "$ref": "urn:catalysis:contract:run:1#/$defs/id"
              },
              "status": {
                "const": "comparable"
              },
              "normalization": {
                "const": "per_adsorbate"
              },
              "unit": {
                "const": "eV"
              },
              "adsorption_energy": {
                "type": "number"
              }
            },
            "required": [
              "structure_id",
              "status",
              "normalization",
              "unit",
              "adsorption_energy"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "structure_id": {
                "$ref": "urn:catalysis:contract:run:1#/$defs/id"
              },
              "status": {
                "const": "noncomparable"
              },
              "reasons": {
                "type": "array",
                "items": {
                  "enum": [
                    "unconverged",
                    "finite_size",
                    "slab_protocol",
                    "electronic_method",
                    "reference_protocol",
                    "reference_stoichiometry",
                    "charge_balance"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "structure_id",
              "status",
              "reasons"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1
    },
    "observed_adsorption": {
      "type": "array",
      "description": "Unfiltered numerical adsorption energies per adsorbate. Review annotations identify limits of interpretation.",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "structure_id": {
            "$ref": "urn:catalysis:contract:run:1#/$defs/id"
          },
          "logical_id": {
            "$ref": "urn:catalysis:contract:run:1#/$defs/id"
          },
          "status": {
            "enum": [
              "comparable",
              "review"
            ]
          },
          "contract_status": {
            "enum": [
              "comparable",
              "noncomparable"
            ]
          },
          "adsorption_energy_eV": {
            "type": "number"
          },
          "normalization": {
            "const": "per_adsorbate"
          },
          "reasons": {
            "type": "array",
            "items": {
              "$ref": "#/properties/results/items/oneOf/1/properties/reasons/items"
            },
            "uniqueItems": true
          },
          "annotations": {
            "type": "array",
            "items": {
              "enum": [
                "cell_size_exceeded",
                "lattice_mismatch",
                "scf_limit_ambiguous"
              ]
            },
            "uniqueItems": true
          }
        },
        "required": [
          "structure_id",
          "logical_id",
          "status",
          "contract_status",
          "adsorption_energy_eV",
          "normalization",
          "reasons",
          "annotations"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "results"
  ],
  "additionalProperties": false
}
