# Deny by default. Extend only with a reviewed source or test artifact.
*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.lock
!/docs/
!/docs/acceptance.md
!/docs/development.md
!/configs/
!/configs/profiles/
!/configs/profiles/intranet.json
!/contracts/
!/contracts/v1/
!/contracts/v1/*.schema.json
!/packages/
!/packages/*.py
!/packages/agent/
!/packages/agent/*.py
!/packages/science/
!/packages/science/*.py
!/tests/
!/tests/test_*.py
!/scripts/
!/scripts/frontend_baseline.py
!/baselines/
!/baselines/frontend.lock.json
!/apps/
!/apps/__init__.py
!/apps/server.py
!/apps/web/
!/apps/web/analysis.js
!/apps/web/analysis.css
!/docs/cell.md
!/docs/kinetics-import.md
!/docs/vasp-import.md
!/docs/file-analysis.md
!/tests/browser_workbench.cjs
!/scripts/synthetic_inputs.py
