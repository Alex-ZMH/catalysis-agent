# Copy to a protected server-only file. Never put these values in browser code.
MLCC_API_ORIGIN=https://your-domain.example/mlcc/api
MLCC_WORKER_TOKEN=the-same-random-worker-token-as-the-website
MLCC_WORKER_ID=mlcc-v100-independent
MLCC_WORKSPACE_ROOT=/srv/mlcc/workspaces
MLCC_BUNDLE_ROOT=/srv/mlcc/runtime/mlcc-agent
MLCC_SITE_CONFIG=/srv/mlcc/config/site.json
MLCC_PYTHON=/srv/mlcc/runtime/mcp/bin/python
MLCC_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MLCC_MODEL=qwen3.8-max
# Set responses for providers whose reasoning + function tools require /responses.
MLCC_MODEL_API_FORMAT=chat-completions
MLCC_MODEL_API_KEY=configure-directly-on-the-worker
